# Server Config
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection (MongoDB Atlas эсвэл Docker / Local)
MONGODB_URI=mongodb://127.0.0.1:27017/goaylal

# JWT Secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# QPay v2 Credentials
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_CLIENT_ID=your_qpay_client_id
QPAY_CLIENT_SECRET=your_qpay_client_secret
QPAY_INVOICE_CODE=GOAYLAL_INVOICE
QPAY_CALLBACK_URL=http://localhost:4000/api/v1/payments/qpay/callback

# DeepSeek AI via The Hive (https://docs.thehive.ai/docs/chat-completions-openai-compatible-llms)
DEEPSEEK_API_KEY=your_hive_secret_key_here
DEEPSEEK_BASE_URL=https://api-cdn.thehive.ai/api/v3
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash-1017

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

