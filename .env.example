# Server Config
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (localhost is always allowed outside production)
CORS_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops to trust for client IPs (rate limiting). Set 1 behind Nginx.
TRUST_PROXY=0

# MongoDB Connection (MongoDB Atlas эсвэл Docker / Local)
# Canonical name. DATABASE_URI (used by the deployment guide) is accepted as an alias; MONGODB_URI wins if both are set.
MONGODB_URI=mongodb://127.0.0.1:27017/goaylal

# JWT signing key. REQUIRED in every environment (there is no default).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production needs at least 32 characters; placeholders and repetitive values are rejected at startup.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# QPay v2 Credentials (all four are required in production)
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/api/v1/payments/qpay/callback
# Development only: fake invoices that can be settled with {"simulate":true}. Refused in production.
# QPAY_MOCK=true

# Unlock fee in MNT. The server is the only source of this amount; client-sent amounts are ignored.
UNLOCK_FEE_MNT=20000

# Comma-separated emails that receive the admin role at login/startup (and cannot be demoted via the API)
ADMIN_EMAILS=
# Development only: accept the literal token "dev-admin-token" on /admin routes. Refused in production.
# ALLOW_DEV_ADMIN_TOKEN=true

# Transitional: allow payments without login while the frontend has no login gate. Set false once it does.
GUEST_CHECKOUT_ENABLED=true
# Send the itinerary email after a payment settles (requires SMTP_*). Off by default.
PAYMENT_EMAIL_ENABLED=false

# Catalog seeding. Defaults to true outside production and false in production; seeding is an idempotent upsert.
# SEED_ON_BOOT=false

# DeepSeek AI via The Hive (https://docs.thehive.ai/docs/chat-completions-openai-compatible-llms). Optional:
# without a key the planner answers with its built-in cost plan.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api-cdn.thehive.ai/api/v3
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash-1017

# Google OAuth 2.0 Credentials (GOOGLE_CLIENT_ID is required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for itinerary emails (optional; without it emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
